<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %>の編集</title>
</head>
<body>
  <h2><%= data.name %>の編集</h2>
  <form action="/timetable_update/<%= number %>">
    <label for="id">科目ID</label>
    <input type="number" name="id" id="id" value="<%= data.id %>" required><br>

    <label for="name">科目名</label>
    <input type="text" name="name" id="name" value="<%= data.name %>" required><br>

    <label for="teacher">担当教員</label>
    <input type="text" name="teacher" id="teacher" value="<%= data.teacher %>"><br>

    <label for="day">曜日</label>
    <select name="day" id="day">
      <% for( let d of ["月","火","水","木","金"] ) { %>
        <option value="<%= d %>" <%= d === data.day ? "selected" : "" %>><%= d %></option>
      <% } %>
    </select><br>

    <label for="period">時限</label>
    <input type="number" name="period" id="period" min="1" max="5" value="<%= data.period %>" required><br>

    <label for="credit">単位数</label>
    <input type="number" name="credit" id="credit" min="0" value="<%= data.credit %>" required><br>

    <label for="room">教室</label>
    <input type="text" name="room" id="room" value="<%= data.room %>"><br>

    <input type="submit" value="更新">
  </form>
  <a href="/timetable">一覧に戻る</a>
</body>
</html>
